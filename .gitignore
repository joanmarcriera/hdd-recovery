# Python / uv
tui/.venv/
tui/__pycache__/
tui/**/__pycache__/
tui/*.pyc
tui/**/*.pyc
bin/__pycache__/
bin/**/__pycache__/
*.egg-info/

# Recovery data — never commit these
*.img
*.img.gz
*.map
*.analysis.sqlite
*.analysis.sqlite-wal
*.analysis.sqlite-shm

# Per-disk job configs and run scripts contain device paths — keep template only
jobs/*.conf
jobs/*.sh
!jobs/ddrescue-job-template.conf

# Export outputs and logs
/mnt/
exports/
logs/
recovered/
indexes/
reports/
.archive/

# Docker env file contains credentials — never commit
docker/.env
docker/*.log
docker/*.log.gz

# AI agent tooling — local-only scratch, not part of the project.
# (.claude/ is intentionally tracked: it holds the project's operator skills.)
.codebuddy/
.continue/
.junie/
.kiro/
.agents/
skills-lock.json

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.bak
*~
__pycache__/
*.pyc

# Symlink into the ignored .agents tree (not portable)
.claude/skills/bash-defensive-patterns
