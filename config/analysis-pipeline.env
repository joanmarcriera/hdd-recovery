#!/usr/bin/env bash

# Base directories. These are designed to be separate container mounts:
# IMAGE_ROOT can live on large storage, DB_ROOT on fast NVMe, EXPORT_ROOT on
# large storage, and LOG_ROOT wherever operational logs should persist.
: "${IMAGE_ROOT:=/data/images}"
: "${DB_ROOT:=/data/db}"
: "${EXPORT_ROOT:=/data/exports}"
: "${LOG_ROOT:=/data/logs}"

# SQLite catalog naming. With DB_ROOT set, foo.img becomes:
#   ${DB_ROOT}/foo.img.analysis.sqlite
: "${DB_SUFFIX:=.analysis.sqlite}"

# Read-only helper roots.
: "${ATTACH_ROOT:=/tmp/hdd-recovery-attach}"
: "${MOUNT_ROOT:=/tmp/hdd-recovery-mounts}"

# Candidate scoring inputs.
: "${WALLET_KEYWORDS_FILE:=/root/hdd-recovery/config/keywords/wallet_keywords.txt}"
: "${INTEREST_KEYWORDS_FILE:=/root/hdd-recovery/config/keywords/generic_interest_keywords.txt}"
: "${PICTURE_EXTENSIONS:=jpg jpeg png gif webp heic tif tiff bmp cr2 nef arw dng raf orf}"

# Optional heavy stages.
: "${ENABLE_RECOLL:=0}"

# Ollama vision model endpoint (used by image-tag-photos.py when --ollama is not given).
: "${OLLAMA_HOST:=}"
: "${OLLAMA_HOSTS:=}"

# Limit how many hits per bulk_extractor feature file are imported into SQLite.
: "${BULK_HIT_LIMIT:=5000}"

# ── Path overrides (optional) ────────────────────────────────────────────────
# Each script keeps a built-in default; set these only to override it.
#
# Wallet-cracking wordlist for image-crack-wallet.sh (the --wordlist flag still
# wins). Empty → <repo>/config/wordlists/rockyou.txt.
: "${WORDLIST_PATH:=}"
# Destination dataset root on TrueNAS for send-image-to-truenas.sh (the 3rd
# positional arg still wins). That script reads this from the environment, so
# export it (or pass the arg) to take effect.
: "${TRUENAS_DEST_ROOT:=/mnt/BigDisk/CryptoBackup}"
# Fallback recovery root for image-serve.py when neither --root nor DB_ROOT is
# set (legacy single-disk layout). Normally DB_ROOT drives this.
: "${RECOVERY_ROOT:=/mnt/recovery16tb/recovery}"
