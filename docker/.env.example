# Copy this file to docker/.env and fill in your values.
# docker compose --env-file docker/.env up -d

# ── Docker Hub ────────────────────────────────────────────────────────────────
# Your Docker Hub username (used when pushing the image).
DOCKERHUB_USER=yourname

# ── Authentication ────────────────────────────────────────────────────────────
# Password for the browser terminal. Must be set — no default.
# The review UI reuses this password unless WEBUI_PASSWORD is set below.
TTYD_PASSWORD=changeme_strong_password

# Username shown in the browser auth dialogs (default: admin).
TTYD_USER=admin

# Optional separate review UI credentials. Leave unset to reuse TTYD_USER and
# TTYD_PASSWORD. /health and /status stay unauthenticated for health probes.
# WEBUI_PASSWORD=changeme_review_password
# WEBUI_USER=admin

# ── Ports ─────────────────────────────────────────────────────────────────────
# Single public UI port. Review UI: http://<host>:7788/
# Browser terminal: http://<host>:7788/terminal/
# Health/status: http://<host>:7788/health and /status
UI_PORT=7788

# ── Data paths ────────────────────────────────────────────────────────────────
# Host paths. Put DB_ROOT_HOST on fast storage such as NVMe, and keep images
# and exports on large-capacity storage.
IMAGE_ROOT_HOST=/mnt/BigDisk/CryptoBackup/images
DB_ROOT_HOST=/mnt/FastPool/hdd-recovery-db
EXPORT_ROOT_HOST=/mnt/BigDisk/CryptoBackup/exports
LOG_ROOT_HOST=/mnt/BigDisk/CryptoBackup/logs

# Container paths. Change only if you also change the matching compose mounts.
IMAGE_ROOT=/data/images
DB_ROOT=/data/db
EXPORT_ROOT=/data/exports
LOG_ROOT=/data/logs

# Optional: explicit path for per-disk ddrescue job configs.
# JOBS_DIR=/mnt/BigDisk/CryptoBackup/jobs

# ── Ollama ────────────────────────────────────────────────────────────────────
# URL of the Ollama API running on the TrueNAS host.
# host-gateway resolves to the Docker host IP — no changes needed if Ollama
# is running directly on TrueNAS with the default port.
OLLAMA_HOST=http://host-gateway:11434

# Optional comma-separated list for parallel photo tagging.
# OLLAMA_HOSTS=http://ollama-a:11434,http://ollama-b:11434
