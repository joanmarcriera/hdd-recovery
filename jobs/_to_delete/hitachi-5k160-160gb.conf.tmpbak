#!/usr/bin/env bash
# Job: Hitachi Travelstar 5K160 (HTS541616J9SA00), 2.5" 160 GB SATA-I, ~2007.
# Notes for this disk:
#   - 2.5" drive: needs 5 V only. If powering from an external PSU, share a
#     power strip with the host and never cut drive power mid-run.
#   - SATA 1.5 Gb/s native; any board port is fine.
# Fill the three ID fields from the live system BEFORE running:
#   lsblk -o NAME,MODEL,SERIAL,SIZE; ls -l /dev/disk/by-path/
#   smartctl -i /dev/sdX          # confirm model+serial match this file
#   blockdev --getsize64 /dev/sdX # confirm SOURCE_SIZE_BYTES

JOB_NAME="hitachi-5k160-160gb"
DATE_TAG="$(date +%Y%m%d)"

SOURCE_DEV=""                      # e.g. /dev/sdd — FILL IN after lsblk
SOURCE_BY_PATH=""                  # e.g. /dev/disk/by-path/pci-...-ata-4 — FILL IN
SOURCE_MODEL="HTS541616J9SA00"
SOURCE_SERIAL=""                   # FILL IN from smartctl -i
SOURCE_SIZE_BYTES="160041885696"   # expected for 160 GB class; verify with blockdev

DEST_MOUNT="/data"  # 990: 7.3T HGST "DATA1" (legacy path was /mnt/recovery16tb)
IMAGES_DIR="$DEST_MOUNT/images"
LOGS_DIR="$DEST_MOUNT/logs"
MANIFESTS_DIR="$DEST_MOUNT/manifests"

BASENAME="${DATE_TAG}_${SOURCE_MODEL}_${SOURCE_SERIAL}_$(basename "$SOURCE_DEV")"

IMAGE_FILE="$IMAGES_DIR/${BASENAME}.img"
MAP_FILE="$LOGS_DIR/${BASENAME}.map"
EVENT_LOG="$LOGS_DIR/${BASENAME}.events.log"
RATE_LOG="$LOGS_DIR/${BASENAME}.rates.log"
MANIFEST_FILE="$MANIFESTS_DIR/${BASENAME}.yaml"

# Conservative defaults. Adjust only with a reason.
RETRY_PASSES="3"
REVERSE_RETRY_PASSES="1"
RETRIM_RETRY_PASSES="1"
PAUSE_ON_ERROR="1s"
MAPFILE_INTERVAL="30s,5s"
