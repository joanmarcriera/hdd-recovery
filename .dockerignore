# Git history
.git
.gitignore

# Python caches (excluded from image; TUI deps are pre-installed via uv sync)
tui/.venv
tui/__pycache__
**/__pycache__
**/*.pyc
**/*.pyo

# Per-disk job configs are user-specific and must not be baked into the image
jobs/

# Runtime artefacts that do not belong in the image
*.log
*.ses
photorec.log
photorec.ses
recovery-monitor/
start-recovery-monitor.sh
install-pi.dev.sh
pi-codex-cc.sh
agent-skills/

# TrueNAS / desktop files
.DS_Store
Thumbs.db

# Dev/agent tooling and notes — never needed in the build context.
# (The image only COPYs bin/ lib/ sql/ config/ tui/, so these were never baked
# in, but excluding them keeps the context sent to the Docker daemon small.)
.github/
.agents/
.codebuddy/
.continue/
.junie/
.kiro/
docs/
AGENTS.md
NEXT-RUN-TODO.md
skills-lock.json
.claude/
