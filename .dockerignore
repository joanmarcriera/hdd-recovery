*.log
*.ses
photorec.log
photorec.ses
recovery-monitor/
start-recovery-monitor.sh
install-pi.dev.sh
pi-codex-cc.sh
agent-skills/

# TrueNAS / desktop files
.DS_Store
Thumbs.db
